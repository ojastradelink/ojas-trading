// ═══════════════════════════════════════════════════════════════════════════
//  Ojas Trading — PostgreSQL schema (Prisma)
//
//  Modeled directly on the client's edible-oil trading workbook + PRD v1.0.
//  Domain: broker deal tracking — every deal is Buyer ↔ Seller with a
//  per-ton brokerage charged to each side.
//
//  Conventions
//  -----------
//  • Multi-tenant: business tables carry `companyId`.
//  • Soft delete: `deletedAt` (NULL = active). Never hard-delete.
//  • Audit columns: createdAt / updatedAt / createdById / updatedById.
//  • Money: Decimal(18,4); Quantity: Decimal(18,3); Weight(kg): Decimal(18,3).
//  • Stored rollups (brokerageTotal) are recomputed by the service layer on write.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────────────────

enum PartyType {
  BUYER
  SELLER
  BOTH
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  RESTORE
  DOWNLOAD
  EXPORT
  IMPORT
  APPROVE
  REJECT
  PASSWORD_CHANGE
  SETTINGS_CHANGE
  PERMISSION_CHANGE
  RATE_UPDATE
}

// ═══════════════════════════════════════════════════════════════════════════
//  TENANT / ORG
// ═══════════════════════════════════════════════════════════════════════════

model Company {
  id          String    @id @default(cuid())
  name        String
  legalName   String?
  gstin       String?   @unique
  pan         String?
  cin         String?
  email       String?
  phone       String?
  addressLine String?
  city        String?
  state       String?
  pincode     String?
  country     String    @default("India")
  logoKey     String?
  financialYearStartMonth Int @default(4)
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  branches        Branch[]
  users           User[]
  roles           Role[]
  parties         Party[]
  products        Product[]
  deals           Deal[]
  degumDetails    DegumDetail[]
  numberSequences NumberSequence[]
  settings        Setting[]
  auditLogs       AuditLog[]

  @@index([name])
  @@index([deletedAt])
  @@map("companies")
}

model Branch {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  code        String
  name        String
  addressLine String?
  city        String?
  state       String?
  contactPerson String?
  phone       String?
  email       String?
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users       User[]

  @@unique([companyId, code])
  @@index([companyId, deletedAt])
  @@map("branches")
}

// ═══════════════════════════════════════════════════════════════════════════
//  AUTH / RBAC
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])

  email         String
  passwordHash  String
  fullName      String
  phone         String?
  avatarKey     String?
  isActive      Boolean   @default(true)
  isSuperAdmin  Boolean   @default(false)
  lastLoginAt   DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  roles         UserRole[]
  refreshTokens RefreshToken[]

  @@unique([companyId, email])
  @@index([email])
  @@index([companyId, deletedAt])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  key         String
  name        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, key])
  @@index([companyId, deletedAt])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  resource    String
  action      String
  description String?

  roles       RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ═══════════════════════════════════════════════════════════════════════════
//  MASTER DATA — Party (Module H) & Product (Module I)
// ═══════════════════════════════════════════════════════════════════════════

model Party {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  code          String?
  name          String
  type          PartyType @default(BOTH)
  contactPerson String?
  phones        String[]  @default([]) // any number of contact numbers
  email         String?
  address       String?
  city          String? // City / Region
  gstin         String?
  notes         String?
  isSelf        Boolean   @default(false) // our own firm — trades reflect as "self" holdings
  isActive      Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  dealsAsBuyer  Deal[]    @relation("DealBuyer")
  dealsAsSeller Deal[]    @relation("DealSeller")

  @@unique([companyId, name])
  @@index([companyId, deletedAt])
  @@index([companyId, type])
  @@index([companyId, isSelf])
  @@map("parties")
}

model Product {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  code          String // SRO, SDO, CDSBO, MDO ...
  name          String
  unit          String    @default("MT")
  // Total brokerage ₹/MT for this commodity — a new deal splits it equally
  // between the buyer and the seller (each side can then be adjusted).
  brokerage     Decimal   @default(0) @db.Decimal(18, 4)
  // Degum material — its deals are imported on a vessel and tracked in the Degum section.
  isDegum       Boolean   @default(false)
  notes         String?
  isActive      Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  deals         Deal[]

  @@unique([companyId, code])
  @@index([companyId, deletedAt])
  @@map("products")
}

// ═══════════════════════════════════════════════════════════════════════════
//  DEALS — one unified broker deal: we match a Buyer with a Seller and charge
//  each side a per-ton brokerage.
//   Brokerage Total = Qty × (Buyer Brokerage + Seller Brokerage)
// ═══════════════════════════════════════════════════════════════════════════

model Deal {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  dealNo        String
  date          DateTime  @default(now())

  buyerPartyId  String?
  buyerParty    Party?    @relation("DealBuyer", fields: [buyerPartyId], references: [id])
  sellerPartyId String?
  sellerParty   Party?    @relation("DealSeller", fields: [sellerPartyId], references: [id])
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id])

  quantity        Decimal @db.Decimal(18, 3)
  rate            Decimal @db.Decimal(18, 4)
  buyerBrokerage  Decimal @default(0) @db.Decimal(18, 4) // ₹/MT charged to the buyer
  sellerBrokerage Decimal @default(0) @db.Decimal(18, 4) // ₹/MT charged to the seller
  brokerageTotal  Decimal @default(0) @db.Decimal(18, 4) // ƒ = Qty × (buyer + seller)

  port             String?
  paymentCondition String?
  liftingDate      DateTime? // lifting due date — drives the trading desk's red / yellow / green
  shipmentMonth    String?
  deposit          Decimal? @db.Decimal(18, 4) // ₹
  dueDays          Int? // payment term: 7 or 10 days from the trade date
  dueDate          DateTime? // ƒ = date + dueDays (older deals may hold an explicit date with no term)

  degumDetail      DegumDetail? // shipment tracking — only for degum materials

  // Trading desk: when our own (self) firm sells, the purchase deal the stock
  // comes from. In hand on a purchase = its qty − the qty of sales pointing at it.
  sourceDealId     String?
  sourceDeal       Deal?   @relation("DealSource", fields: [sourceDealId], references: [id])
  sales            Deal[]  @relation("DealSource")

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([companyId, dealNo])
  @@index([companyId, deletedAt])
  @@index([companyId, date])
  @@index([companyId, productId])
  @@index([companyId, buyerPartyId])
  @@index([companyId, sellerPartyId])
  @@index([companyId, sourceDealId])
  @@map("deals")
}

// ═══════════════════════════════════════════════════════════════════════════
//  DEGUM — shipment tracking for deals on a degum material. The trade is agreed
//  now; the vessel arrives later. Kept in its own table so filling these in
//  never touches the deal itself.
//   Payment Due Date = Actual Clearance Date + Payment Due Days (5–15)
//   Final Payment    = ((Rate + Duty) × Qty) × (1 + 5% GST − 0.1% TDS) − Deposit
// ═══════════════════════════════════════════════════════════════════════════

model DegumDetail {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  dealId         String    @unique
  deal           Deal      @relation(fields: [dealId], references: [id])

  vesselName     String?
  vesselEta      DateTime? // tentative arrival at port
  clearanceDate  DateTime? // actual vessel clearance
  tank           String?
  terminal       String?
  chain          String?
  duty           Decimal?  @db.Decimal(18, 4) // ₹/MT, added to the rate for the final payment
  paymentDueDays Int? // 5–15 days after clearance
  paymentDueDate DateTime? // ƒ = clearanceDate + paymentDueDays
  // Final payment is not stored: it is calculated on read (src/degum/payment.ts).

  createdById    String?
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId])
  @@map("degum_details")
}

// ═══════════════════════════════════════════════════════════════════════════
//  AUDIT / NUMBERING / SETTINGS
// ═══════════════════════════════════════════════════════════════════════════

model AuditLog {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  actorId     String?
  action      AuditAction
  entityType  String
  entityId    String?
  summary     String?
  diff        Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([companyId, actorId])
  @@index([companyId, action])
  @@map("audit_logs")
}

model NumberSequence {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  key         String
  prefix      String   @default("")
  padding     Int      @default(5)
  nextValue   Int      @default(1)
  resetYearly Boolean  @default(true)
  yearLabel   String?
  updatedAt   DateTime @updatedAt

  @@unique([companyId, key])
  @@map("number_sequences")
}

model Setting {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@map("settings")
}
